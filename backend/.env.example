# Food omniScan API: copy to .env and fill in. Never commit real secrets.

ENVIRONMENT=development            # development | test | staging | production
DATABASE_URL=sqlite:///./omniscan.db
# Production: DATABASE_URL=postgresql+psycopg://omniscan:CHANGE_ME@db:5432/omniscan
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_APP_URL=http://localhost:3000

# Market defaults (US standards first)
DEFAULT_REGION=US
DEFAULT_CURRENCY=USD
DEFAULT_LOCALE=en-US

# --- Auth --------------------------------------------------------------
# local = email/password issued by this API; firebase = verify Firebase ID tokens; both = accept either
AUTH_PROVIDER=local
JWT_SECRET=generate-a-64-char-random-string   # python -c "import secrets;print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_MINUTES=1440
FIREBASE_PROJECT_ID=                # required when AUTH_PROVIDER=firebase|both (no service account needed)
BOOTSTRAP_ADMIN_EMAILS=             # comma-separated; promoted to admin at registration

# --- Data providers ----------------------------------------------------------
OFF_USER_AGENT=FoodOmniScan/0.1 (contact: you@yourdomain.com)   # required by Open Food Facts
PRODUCT_CACHE_HOURS=168
USDA_API_KEY=                       # free key: https://fdc.nal.usda.gov/api-key-signup (DEMO_KEY for light testing)

# --- AI (server-side only; never ship to clients) ---------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Payments -------------------------------------------------------------
STRIPE_SECRET_KEY=                  # sk_live_... / sk_test_...
STRIPE_WEBHOOK_SECRET=              # whsec_...
STRIPE_PRICES={"plus_month":"","plus_year":"","premium_month":"","premium_year":"","family_month":"","family_year":""}
REVENUECAT_WEBHOOK_AUTH=            # the Authorization value configured in RevenueCat webhooks
PAYSTACK_SECRET_KEY=                # African markets (optional)

# --- Uploads & abuse protection -----------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
