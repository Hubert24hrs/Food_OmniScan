{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd backend && .venv\\Scripts\\python -m uvicorn app.main:app --port 8010 --reload"],
      "port": 8010,
      "autoPort": false
    },
    {
      "name": "web",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd web && set NEXT_PUBLIC_API_URL=http://localhost:8010/api/v1&& npm run dev -- --port 3000"],
      "port": 3000,
      "autoPort": false
    }
  ]
}
